@page "/sorteio"
@rendermode InteractiveServer

<h3>Sorteador de Números</h3>

<button class="btn btn-success my-2" @onclick="SorteiaNumero">Gerar Número Aleatório</button>

@if (numeroSorteado.HasValue)
{
    <h2>Número Sorteado: @numeroSorteado</h2>
}

@code {
    private int? numeroSorteado;

    private void SorteiaNumero()
    {
        Random random = new Random();
        numeroSorteado = random.Next(1, 101);
    }
}
