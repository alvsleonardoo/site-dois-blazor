@page "/media"
@rendermode InteractiveServer

<h3>Calculadora de Média do Aluno</h3>

<div>
    <label>Nota 1:</label>
    <input type="number" step="0.1" @bind="nota1" />
</div>
<div>
    <label>Nota 2:</label>
    <input type="number" step="0.1" @bind="nota2" />
</div>
<button class="btn btn-primary my-2" @onclick="CalcularMedia">Calcular Média</button>

@if (media.HasValue)
{
    <p>Média: @media.Value.ToString("F1")</p>
    @if (media >= 7.0)
    {
        <p style="color: green; font-weight: bold;">Aprovado!</p>
    }
    else
    {
        <p style="color: red; font-weight: bold;">Reprovado!</p>
    }
}

@code {
    private double nota1;
    private double nota2;
    private double? media;

    private void CalcularMedia()
    {
        media = (nota1 + nota2) / 2.0;
    }
}